{
  "name": "lens-design-system",
  "version": "1.0.0",
  "description": "Lens design system engineered for AI assisted software development consumption.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jackson-NSANZIMANA/design-system.git"
  },
  "keywords": [
    "design-system",
    "AI-assisted-software-development",
    "components",
    "lens"
  ],
  "author": "Jackson NSANZIMANA",
  "dependencies": {
    "@atlaskit/icon": "^25.8.0",
    "@atlaskit/icon-lab": "^4.19.0",
    "@jackson_nsanzimana/atlassian-fonts": "^1.0.0",
    "@loomhq/lens": "12.18.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-plugin-lens-compliance": "link:eslint-plugin-lens-compliance",
    "eslint-plugin-react": "^7.37.5",
    "glob": "^13.0.6",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "remark-parse": "^11.0.0",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.59.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "scripts": {
    "kb:sync-types": "tsx scripts/kb/sync-types.ts",
    "kb:validate-links": "tsx scripts/kb/validate-links.ts",
    "kb:validate-exports": "tsx scripts/kb/validate-exports.ts",
    "kb:validate": "pnpm kb:sync-types && node scripts/generate-session-context.js && pnpm kb:validate-links && pnpm kb:validate-exports",
    "generate:mastery-db": "node scripts/generate-mastery-db.js",
    "generate:component-mastery-db": "node scripts/generate-component-mastery-db.js",
    "generate:lint-dbs": "pnpm generate:mastery-db && pnpm generate:component-mastery-db",
    "verify:lint-dbs": "node scripts/verify-lint-db-fresh.js",
    "prepare": "husky",
    "context:task": "bash scripts/generate-task-context.sh",
    "lint:feedback": "bash scripts/lint-feedback.sh"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --max-warnings=0"
    ]
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=9 <10"
  },
  "peerDependencies": {
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0"
  }
}